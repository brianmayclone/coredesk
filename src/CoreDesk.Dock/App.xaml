<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="CoreDesk_Dock.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:CoreDesk_App.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <converters:IconPathToImageSourceConverter x:Key="IconPathToImageSourceConverter" />
            <converters:IconPathToBrushConverter x:Key="IconPathToBrushConverter" />
            <converters:IconPathToVisibilityConverter x:Key="IconPathToVisibilityConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
