<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="CoreDesk_Dock.DockOverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CoreDesk_Dock"
    Title="CoreDesk Dock">

    <Grid
        x:Name="Root"
        Background="Transparent"
        PointerEntered="OnRootPointerEntered"
        PointerExited="OnRootPointerExited"
        PointerPressed="OnRootPointerPressed"
        PointerMoved="OnRootPointerMoved"
        PointerReleased="OnRootPointerReleased"
        PointerCanceled="OnRootPointerCanceled">
        <local:DockView x:Name="Dock" Opacity="1">
            <local:DockView.RenderTransform>
                <CompositeTransform x:Name="DockTransform" TranslateY="0" ScaleX="1" ScaleY="1" />
            </local:DockView.RenderTransform>
        </local:DockView>
    </Grid>
</Window>
