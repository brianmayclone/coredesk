<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="CoreDesk_App.StatusOverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="CoreDesk Status Bar">

    <Grid x:Name="Root" Background="Transparent">
        <Border x:Name="StatusSurface" Background="Transparent">
            <Grid Padding="22,0" ColumnSpacing="12" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Text="{Binding CurrentTime}" FontSize="14" FontWeight="SemiBold" Foreground="{Binding ElementName=Root, Path=Tag}" />
                    <TextBlock Text="{Binding NetworkLabel}" FontSize="12" Foreground="{Binding ElementName=Root, Path=Tag}" Opacity="0.86" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <TextBlock Text="{Binding KeyboardLabel}" FontSize="12" Foreground="{Binding ElementName=Root, Path=Tag}" Opacity="0.86" />
                    <TextBlock Text="{Binding BatteryLabel}" FontSize="12" FontWeight="SemiBold" Foreground="{Binding ElementName=Root, Path=Tag}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
