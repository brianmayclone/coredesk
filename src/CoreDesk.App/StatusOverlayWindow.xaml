<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="CoreDesk_App.StatusOverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="CoreDesk Status Bar">

    <Grid
        x:Name="Root"
        Background="Transparent"
        PointerPressed="OnRootPointerPressed"
        PointerReleased="OnRootPointerReleased">
        <Border x:Name="StatusSurface" Background="Transparent">
            <Grid>
                <Border x:Name="DarkStatusBackdrop" Background="#EE0F1216" Opacity="0" />
                <Grid Padding="22,0" ColumnSpacing="12" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <TextBlock Text="{Binding CurrentTime}" FontSize="14" FontWeight="SemiBold" Foreground="{Binding ElementName=Root, Path=Tag}" />
                    </StackPanel>

                    <Border
                        x:Name="ControlCenterHotZone"
                        Grid.Column="1"
                        MinWidth="128"
                        Height="32"
                        Padding="12,0"
                        HorizontalAlignment="Right"
                        Background="Transparent"
                        CornerRadius="16"
                        Tapped="OnControlCenterHotZoneTapped">
                        <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE701;" FontSize="13" Foreground="{Binding ElementName=Root, Path=Tag}" />
                            <FontIcon Glyph="&#xE702;" FontSize="13" Foreground="{Binding ElementName=Root, Path=Tag}" />
                            <TextBlock Text="{Binding BatteryPercentLabel}" Foreground="{Binding ElementName=Root, Path=Tag}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Border Width="22" Height="11" BorderBrush="{Binding ElementName=Root, Path=Tag}" BorderThickness="1.4" CornerRadius="3" VerticalAlignment="Center">
                                <Border Width="15" Height="6" Margin="2,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{Binding ElementName=Root, Path=Tag}" CornerRadius="2" />
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
