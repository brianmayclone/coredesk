<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="CoreDesk_App.DockView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:glass="using:CoreDesk.LiquidGlass"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="using:CoreDesk.Application.ViewModels"
    mc:Ignorable="d">

    <Grid x:Name="Root" Background="Transparent">
        <Grid.Resources>
            <SolidColorBrush x:Key="ButtonBackground" Color="Transparent" />
            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="Transparent" />
            <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
            <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
            <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="Transparent" />

            <Style x:Key="DockIconButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="78" />
                <Setter Property="Height" Value="78" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </Grid.Resources>

        <glass:LiquidGlassPanel
            x:Name="LiquidDockSurface"
            Height="92"
            Margin="28,26,28,14"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Center"
            AutomationProperties.Name="CoreDesk Dock">
            <Grid>
                <Border
                    x:Name="LiquidDockChrome"
                    BorderBrush="#7CFFFFFF"
                    BorderThickness="1"
                    CornerRadius="38"
                    IsHitTestVisible="False">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#52FFFFFF" Offset="0" />
                            <GradientStop Color="#3AF6F8FC" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <Border CornerRadius="38" IsHitTestVisible="False">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#70FFFFFF" Offset="0" />
                            <GradientStop Color="#0AFFFFFF" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <Border CornerRadius="38" IsHitTestVisible="False">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#00000000" Offset="0" />
                            <GradientStop Color="#26000000" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <Border
                    Height="1"
                    Margin="38,1,38,0"
                    VerticalAlignment="Top"
                    Background="#96FFFFFF"
                    CornerRadius="0.5"
                    IsHitTestVisible="False" />

                <StackPanel
                    x:Name="DockItemsHost"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="12">
                    <Button
                        Style="{StaticResource DockIconButtonStyle}"
                        Click="OnHomeClick"
                        PointerEntered="OnDockButtonPointerEntered"
                        PointerExited="OnDockButtonPointerExited"
                        AutomationProperties.Name="Home">
                        <Grid Width="64" Height="64">
                            <Border CornerRadius="14">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#FFFFB74D" Offset="0" />
                                        <GradientStop Color="#FFFF7043" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <FontIcon
                                FontSize="37"
                                Foreground="White"
                                Glyph="&#xE80F;" />
                        </Grid>
                    </Button>

                    <ItemsControl ItemsSource="{Binding PinnedDockItems}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="12" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="viewModels:DockItemViewModel">
                                <Button
                                    Style="{StaticResource DockIconButtonStyle}"
                                    Click="OnDockItemClick"
                                    PointerEntered="OnDockButtonPointerEntered"
                                    PointerExited="OnDockButtonPointerExited"
                                    Tag="{x:Bind}">
                                    <Grid Width="78" Height="78">
                                        <Grid Width="64" Height="64" VerticalAlignment="Center">
                                            <Border
                                                Background="{x:Bind IconPath, Converter={StaticResource IconPathToBrushConverter}, Mode=OneWay}"
                                                CornerRadius="14"
                                                Visibility="{x:Bind IconPath, Converter={StaticResource IconPathToVisibilityConverter}, ConverterParameter=Invert, Mode=OneWay}">
                                                <FontIcon
                                                    FontSize="29"
                                                    Foreground="#F2FFFFFF"
                                                    Glyph="&#xECAA;" />
                                            </Border>
                                            <Image
                                                Source="{x:Bind IconPath, Converter={StaticResource IconPathToImageSourceConverter}, Mode=OneWay}"
                                                Stretch="Uniform"
                                                Visibility="{x:Bind IconPath, Converter={StaticResource IconPathToVisibilityConverter}, Mode=OneWay}" />
                                        </Grid>
                                        <Border
                                            Width="8"
                                            Height="3"
                                            Margin="0,0,0,9"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Bottom"
                                            Background="#FF0A84FF"
                                            CornerRadius="1.5"
                                            Visibility="{x:Bind IsRunning, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border
                        Width="1"
                        Height="50"
                        Margin="6,0"
                        Background="#72FFFFFF"
                        CornerRadius="0.5"
                        Visibility="{Binding RunningDockItems.Count, Converter={StaticResource CountToVisibilityConverter}}" />

                    <ItemsControl ItemsSource="{Binding RunningDockItems}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="12" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="viewModels:DockItemViewModel">
                                <Button
                                    Style="{StaticResource DockIconButtonStyle}"
                                    Click="OnDockItemClick"
                                    PointerEntered="OnDockButtonPointerEntered"
                                    PointerExited="OnDockButtonPointerExited"
                                    Tag="{x:Bind}">
                                    <Grid Width="78" Height="78">
                                        <Grid Width="64" Height="64" VerticalAlignment="Center">
                                            <Border
                                                Background="{x:Bind IconPath, Converter={StaticResource IconPathToBrushConverter}, Mode=OneWay}"
                                                CornerRadius="14"
                                                Visibility="{x:Bind IconPath, Converter={StaticResource IconPathToVisibilityConverter}, ConverterParameter=Invert, Mode=OneWay}">
                                                <FontIcon
                                                    FontSize="29"
                                                    Foreground="#F2FFFFFF"
                                                    Glyph="&#xECAA;" />
                                            </Border>
                                            <Image
                                                Source="{x:Bind IconPath, Converter={StaticResource IconPathToImageSourceConverter}, Mode=OneWay}"
                                                Stretch="Uniform"
                                                Visibility="{x:Bind IconPath, Converter={StaticResource IconPathToVisibilityConverter}, Mode=OneWay}" />
                                        </Grid>
                                        <Border
                                            Width="8"
                                            Height="3"
                                            Margin="0,0,0,9"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Bottom"
                                            Background="#FF0A84FF"
                                            CornerRadius="1.5" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>
        </glass:LiquidGlassPanel>
    </Grid>
</UserControl>
