<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="CoreDesk_App.AppIconContextMenu"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CoreDesk_App"
    Visibility="Collapsed">

    <UserControl.Resources>
        <Style x:Key="AppContextMenuButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="54" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Margin" Value="6,0" />
        </Style>
    </UserControl.Resources>

    <Grid
        x:Name="Backdrop"
        Background="Transparent"
        Tapped="OnBackdropTapped">
        <Canvas x:Name="PlacementCanvas">
            <StackPanel
                x:Name="MenuRoot"
                Canvas.Left="0"
                Canvas.Top="0"
                Width="302"
                RenderTransformOrigin="0,0"
                Spacing="10">
                <StackPanel.RenderTransform>
                    <ScaleTransform x:Name="MenuScaleTransform" ScaleX="1" ScaleY="1" />
                </StackPanel.RenderTransform>

                <Border
                    x:Name="PreviewRoot"
                    Width="136"
                    MinHeight="164"
                    Padding="10"
                    HorizontalAlignment="Left"
                    Background="#26FFFFFF"
                    BorderBrush="#42FFFFFF"
                    BorderThickness="1"
                    CornerRadius="28"
                    Translation="0,0,42">
                    <Border.Shadow>
                        <ThemeShadow />
                    </Border.Shadow>
                    <StackPanel Spacing="8">
                        <Border
                            Width="108"
                            Height="108"
                            HorizontalAlignment="Center"
                            Background="{x:Bind IconPath, Mode=OneWay, Converter={StaticResource IconPathToBrushConverter}}"
                            CornerRadius="24">
                            <Grid>
                                <FontIcon
                                    Glyph="&#xECAA;"
                                    FontSize="42"
                                    Foreground="#EFFFFFFF"
                                    Visibility="{x:Bind IconPath, Mode=OneWay, Converter={StaticResource IconPathToVisibilityConverter}, ConverterParameter=Invert}" />
                                <Image
                                    Source="{x:Bind IconPath, Mode=OneWay, Converter={StaticResource IconPathToImageSourceConverter}}"
                                    Margin="18"
                                    Stretch="Uniform"
                                    Visibility="{x:Bind IconPath, Mode=OneWay, Converter={StaticResource IconPathToVisibilityConverter}}" />
                            </Grid>
                        </Border>
                        <TextBlock
                            Text="{x:Bind DisplayName, Mode=OneWay}"
                            TextAlignment="Center"
                            TextWrapping="Wrap"
                            MaxLines="2"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="White" />
                    </StackPanel>
                </Border>

                <Border
                    x:Name="MenuPanel"
                    Width="302"
                    Padding="0,6"
                    BorderBrush="#B8FFFFFF"
                    BorderThickness="1"
                    CornerRadius="18"
                    Translation="0,0,44">
                    <Border.Background>
                        <AcrylicBrush TintColor="#F7F8FA" TintOpacity="0.86" TintLuminosityOpacity="0.9" FallbackColor="#F4F7F8FA" />
                    </Border.Background>
                    <Border.Shadow>
                        <ThemeShadow />
                    </Border.Shadow>
                    <StackPanel>
                        <Button Style="{StaticResource AppContextMenuButtonStyle}" Click="OnOpenClicked">
                            <local:AppIconContextMenuRow Glyph="&#xE8E5;" Text="&#x00D6;ffnen" />
                        </Button>
                        <Button Style="{StaticResource AppContextMenuButtonStyle}" Click="OnInfoClicked">
                            <local:AppIconContextMenuRow Glyph="&#xE946;" Text="App-Info" />
                        </Button>
                        <Rectangle Height="1" Margin="16,5" Fill="#1F000000" />
                        <Button Style="{StaticResource AppContextMenuButtonStyle}" Click="OnRemoveClicked">
                            <local:AppIconContextMenuRow Glyph="&#xE738;" Text="Vom Home-Bildschirm entfernen" />
                        </Button>
                        <Button Style="{StaticResource AppContextMenuButtonStyle}" Click="OnDeleteClicked">
                            <local:AppIconContextMenuRow Glyph="&#xE74D;" Text="App l&#x00F6;schen" IsDestructive="True" />
                        </Button>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Canvas>
    </Grid>
</UserControl>
