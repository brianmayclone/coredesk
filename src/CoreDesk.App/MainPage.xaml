<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="CoreDesk_App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:CoreDesk.Abstractions.Models"
    xmlns:viewModels="using:CoreDesk.Application.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:CoreDesk_App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid
        x:Name="Root"
        AutomationProperties.Name="CoreDesk Homescreen"
        Background="Transparent"
        SizeChanged="OnRootSizeChanged">
        <Grid>
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#20394F" Offset="0" />
                    <GradientStop Color="#67869C" Offset="0.48" />
                    <GradientStop Color="#C08B6A" Offset="1" />
                </LinearGradientBrush>
            </Grid.Background>
        </Grid>

        <Image
            x:Name="WallpaperImage"
            Stretch="UniformToFill"
            Opacity="0.94" />

        <Grid>
            <Grid.Background>
                <RadialGradientBrush Center="0.58,0.35" RadiusX="0.92" RadiusY="0.92">
                    <GradientStop Color="#44FFFFFF" Offset="0" />
                    <GradientStop Color="#26344B61" Offset="0.62" />
                    <GradientStop Color="#66101A24" Offset="1" />
                </RadialGradientBrush>
            </Grid.Background>
        </Grid>

        <Border Background="#26000000" />

        <Grid Padding="{Binding ShellPadding, Converter={StaticResource DoubleToUniformThicknessConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Height="0" />

            <Grid
                Grid.Row="1"
                AllowDrop="True"
                DragOver="OnWidgetDragOver"
                DragLeave="OnWidgetDragLeave"
                Drop="OnWidgetDrop"
                Margin="0,28,0,8"
                MinHeight="300">
                <ItemsControl
                    x:Name="WidgetsStrip"
                    ItemsSource="{x:Bind ViewModel.Widgets, Mode=OneWay}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas MinHeight="300" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="viewModels:HomeWidgetViewModel">
                            <Border
                                Width="{x:Bind Width, Mode=OneWay}"
                                Height="{x:Bind Height, Mode=OneWay}"
                                Padding="24,20"
                                CanDrag="True"
                                DragStarting="OnWidgetDragStarting"
                                DropCompleted="OnWidgetDragCompleted"
                                Opacity="{x:Bind Opacity, Mode=OneWay}"
                                PointerPressed="OnTilePointerPressed"
                                PointerReleased="OnTilePointerReleased"
                                PointerExited="OnTilePointerReleased"
                                RenderTransformOrigin="0.5,0.5"
                                Translation="0,0,32"
                                Background="#F1FFFFFF"
                                BorderBrush="#72FFFFFF"
                                BorderThickness="1"
                                CornerRadius="20">
                                <Border.Shadow>
                                    <ThemeShadow />
                                </Border.Shadow>
                                <StackPanel Spacing="5">
                                    <TextBlock Text="{x:Bind Title}" Foreground="#B0212B34" FontSize="15" FontWeight="SemiBold" />
                                    <TextBlock Text="{x:Bind PrimaryText}" Foreground="#FF111820" FontSize="30" FontWeight="SemiBold" MaxLines="1" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind SecondaryText}" Foreground="#CC111820" FontSize="15" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>

            <GridView
                x:Name="HomeGrid"
                Grid.Row="2"
                AllowDrop="True"
                CanDragItems="True"
                DragItemsStarting="OnAppDragItemsStarting"
                DragOver="OnHomeGridDragOver"
                DragLeave="OnHomeGridDragLeave"
                Drop="OnHomeGridDrop"
                Margin="0,22,0,24"
                ItemsSource="{x:Bind ViewModel.HomeTiles, Mode=OneWay}"
                SelectionMode="None">
                <GridView.ItemContainerStyle>
                    <Style TargetType="GridViewItem">
                        <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}" />
                    </Style>
                </GridView.ItemContainerStyle>
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="8" />
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:HomeTileViewModel">
                        <StackPanel
                            Width="150"
                            Height="174"
                            Padding="8"
                            CanDrag="True"
                            DragStarting="OnHomeTileDragStarting"
                            Spacing="10"
                            Holding="OnHomeTileHolding"
                            PointerPressed="OnTilePointerPressed"
                            PointerReleased="OnTilePointerReleased"
                            PointerExited="OnTilePointerReleased"
                            RightTapped="OnHomeTileRightTapped"
                            Tapped="OnHomeTileTapped"
                            RenderTransformOrigin="0.5,0.45"
                            AutomationProperties.Name="{x:Bind DisplayName, Mode=OneWay}">
                            <Border
                                Width="108"
                                Height="108"
                                HorizontalAlignment="Center"
                                Translation="0,0,20"
                                Background="{Binding IconPath, Converter={StaticResource IconPathToBrushConverter}}"
                                CornerRadius="22"
                                Visibility="{Binding IsAppTile, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Border.Shadow>
                                    <ThemeShadow />
                                </Border.Shadow>
                                <Grid>
                                    <FontIcon
                                        Glyph="&#xECAA;"
                                        FontSize="42"
                                        Foreground="#EFFFFFFF"
                                        Visibility="{Binding IconPath, Converter={StaticResource IconPathToVisibilityConverter}, ConverterParameter=Invert}" />
                                    <Image
                                        Source="{Binding IconPath, Converter={StaticResource IconPathToImageSourceConverter}}"
                                        Margin="19"
                                        Stretch="Uniform"
                                        Visibility="{Binding IconPath, Converter={StaticResource IconPathToVisibilityConverter}}" />
                                </Grid>
                            </Border>
                            <Border
                                Width="108"
                                Height="108"
                                HorizontalAlignment="Center"
                                Translation="0,0,20"
                                Background="#DCF7F8FA"
                                CornerRadius="22"
                                Visibility="{Binding IsFolderTile, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Border.Shadow>
                                    <ThemeShadow />
                                </Border.Shadow>
                                <Grid Padding="12">
                                    <ItemsControl ItemsSource="{x:Bind FolderPreviewApps, Mode=OneWay}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="2" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:AppEntry">
                                                <Border Width="38" Height="38" Margin="3" Background="{Binding IconPath, Converter={StaticResource IconPathToBrushConverter}}" CornerRadius="8">
                                                    <Grid>
                                                        <FontIcon Glyph="&#xECAA;" FontSize="17" Foreground="#EFFFFFFF" Visibility="{Binding IconPath, Converter={StaticResource IconPathToVisibilityConverter}, ConverterParameter=Invert}" />
                                                        <Image Source="{Binding IconPath, Converter={StaticResource IconPathToImageSourceConverter}}" Margin="5" Stretch="Uniform" Visibility="{Binding IconPath, Converter={StaticResource IconPathToVisibilityConverter}}" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Border Width="24" Height="24" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="#F2FFFFFF" CornerRadius="12" Visibility="{Binding HasFolderApps, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="{x:Bind AppCount}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="#FF111820" />
                                    </Border>
                                </Grid>
                            </Border>
                            <Grid>
                                <TextBlock
                                    Margin="0,1,0,0"
                                    Text="{x:Bind DisplayName, Mode=OneWay}"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap"
                                    MaxLines="2"
                                    Foreground="#66000000"
                                    FontWeight="SemiBold"
                                    FontSize="13" />
                                <TextBlock
                                    Margin="0,2,0,0"
                                    Text="{x:Bind DisplayName, Mode=OneWay}"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap"
                                    MaxLines="2"
                                    Foreground="#33000000"
                                    FontWeight="SemiBold"
                                    FontSize="13" />
                                <TextBlock
                                    Text="{x:Bind DisplayName, Mode=OneWay}"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap"
                                    MaxLines="2"
                                    Foreground="White"
                                    FontWeight="SemiBold"
                                    FontSize="13" />
                            </Grid>
                        </StackPanel>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>

            <ItemsControl Grid.Row="3" HorizontalAlignment="Center" Margin="0,0,0,154" ItemsSource="{x:Bind ViewModel.PageIndicators, Mode=OneWay}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="9" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:PageIndicatorViewModel">
                        <Border Width="{x:Bind Width, Mode=OneWay}" Height="8" Background="#FFFFFFFF" Opacity="{x:Bind Opacity, Mode=OneWay}" CornerRadius="4" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </Grid>

        <Grid
            AutomationProperties.Name="CoreDesk App Drawer"
            Visibility="{Binding IsDrawerOpen, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.Background>
                <AcrylicBrush TintColor="#111820" TintOpacity="0.78" TintLuminosityOpacity="0.68" FallbackColor="#F2111820" />
            </Grid.Background>
            <Grid Padding="{Binding ShellPadding, Converter={StaticResource DoubleToUniformThicknessConverter}}" RowSpacing="22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid ColumnSpacing="18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Height="64" Padding="18,0" Background="#F2FFFFFF" BorderBrush="#44FFFFFF" BorderThickness="1" CornerRadius="22">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE721;" FontSize="20" Foreground="#99101820" VerticalAlignment="Center" />
                            <TextBox
                                Grid.Column="1"
                                AutomationProperties.Name="App Drawer Search"
                                PlaceholderText="{x:Bind ViewModel.SearchPlaceholder}"
                                Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                FontSize="20"
                                BorderThickness="0"
                                Background="Transparent"
                                Foreground="#FF101820"
                                PlaceholderForeground="#99101820"
                                Height="52"
                                Padding="0"
                                VerticalAlignment="Center"
                                VerticalContentAlignment="Center" />
                        </Grid>
                    </Border>
                    <Button Grid.Column="1" Command="{x:Bind ViewModel.CloseDrawerCommand}" Width="64" Height="64" Padding="0" AutomationProperties.Name="Close App Drawer">
                        <FontIcon Glyph="&#xE711;" />
                    </Button>
                </Grid>

                <GridView
                    x:Name="DrawerGrid"
                    Grid.Row="1"
                    CanDragItems="True"
                    DragItemsStarting="OnAppDragItemsStarting"
                    IsItemClickEnabled="True"
                    ItemClick="OnAppItemClick"
                    ItemsSource="{x:Bind ViewModel.DrawerApps, Mode=OneWay}"
                    SelectionMode="None">
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="models:AppEntry">
                            <StackPanel
                                Width="154"
                                Height="158"
                                Padding="8"
                                CanDrag="True"
                                DragStarting="OnDrawerAppDragStarting"
                                PointerPressed="OnTilePointerPressed"
                                PointerReleased="OnTilePointerReleased"
                                PointerExited="OnTilePointerReleased"
                                RenderTransformOrigin="0.5,0.45"
                                Spacing="8">
                                <Border
                                    Width="96"
                                    Height="96"
                                    HorizontalAlignment="Center"
                                    Background="{Binding IconPath, Converter={StaticResource IconPathToBrushConverter}}"
                                    CornerRadius="22">
                                    <Grid>
                                        <FontIcon Glyph="&#xECAA;" FontSize="40" Foreground="#EFFFFFFF" Visibility="{Binding IconPath, Converter={StaticResource IconPathToVisibilityConverter}, ConverterParameter=Invert}" />
                                        <Image Source="{Binding IconPath, Converter={StaticResource IconPathToImageSourceConverter}}" Margin="17" Stretch="Uniform" Visibility="{Binding IconPath, Converter={StaticResource IconPathToVisibilityConverter}}" />
                                    </Grid>
                                </Border>
                                <TextBlock Text="{x:Bind DisplayName}" TextAlignment="Center" TextWrapping="Wrap" MaxLines="2" Foreground="White" FontWeight="SemiBold" FontSize="13" />
                            </StackPanel>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </Grid>
        </Grid>

        <Grid
            AutomationProperties.Name="CoreDesk Folder"
            Tapped="OnFolderBackdropTapped"
            Visibility="{Binding IsFolderOpen, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.Background>
                <AcrylicBrush TintColor="#101820" TintOpacity="0.55" TintLuminosityOpacity="0.55" FallbackColor="#AA101820" />
            </Grid.Background>
            <Border
                Width="680"
                MinHeight="460"
                Padding="32"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#F2FFFFFF"
                BorderBrush="#66FFFFFF"
                BorderThickness="1"
                CornerRadius="38"
                Tapped="OnFolderPanelTapped">
                <StackPanel Spacing="22">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding OpenFolderTile.Name}" FontSize="30" FontWeight="SemiBold" Foreground="#FF111820" />
                        <Button Grid.Column="1" Command="{x:Bind ViewModel.CloseFolderCommand}" AutomationProperties.Name="Close Folder">
                            <FontIcon Glyph="&#xE711;" />
                        </Button>
                    </Grid>
                    <GridView
                        x:Name="FolderGrid"
                        MaxHeight="420"
                        CanDragItems="True"
                        DragItemsStarting="OnAppDragItemsStarting"
                        IsItemClickEnabled="True"
                        ItemClick="OnAppItemClick"
                        ItemsSource="{x:Bind ViewModel.OpenFolderApps, Mode=OneWay}"
                        SelectionMode="None">
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="models:AppEntry">
                                <StackPanel
                                    Width="136"
                                    Height="146"
                                    Padding="8"
                                    Spacing="8"
                                    PointerPressed="OnTilePointerPressed"
                                    PointerReleased="OnTilePointerReleased"
                                    PointerExited="OnTilePointerReleased"
                                    RenderTransformOrigin="0.5,0.45">
                                    <Border
                                        Width="86"
                                        Height="86"
                                        HorizontalAlignment="Center"
                                        Background="{Binding IconPath, Converter={StaticResource IconPathToBrushConverter}}"
                                        CornerRadius="20">
                                        <Grid>
                                            <FontIcon Glyph="&#xECAA;" FontSize="34" Foreground="#EFFFFFFF" Visibility="{Binding IconPath, Converter={StaticResource IconPathToVisibilityConverter}, ConverterParameter=Invert}" />
                                            <Image Source="{Binding IconPath, Converter={StaticResource IconPathToImageSourceConverter}}" Margin="16" Stretch="Uniform" Visibility="{Binding IconPath, Converter={StaticResource IconPathToVisibilityConverter}}" />
                                        </Grid>
                                    </Border>
                                    <TextBlock Text="{x:Bind DisplayName}" TextAlignment="Center" TextWrapping="Wrap" MaxLines="2" Foreground="#FF111820" FontSize="13" FontWeight="SemiBold" />
                                </StackPanel>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                </StackPanel>
            </Border>
        </Grid>

        <Grid
            AutomationProperties.Name="CoreDesk Control Center"
            Visibility="{Binding IsControlCenterOpen, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border HorizontalAlignment="Stretch" Background="#33071018" Tapped="OnControlCenterBackdropTapped" />
            <Border
                Width="{x:Bind ViewModel.ControlCenterWidth, Mode=OneWay}"
                MinWidth="306"
                Margin="0,38,36,0"
                Padding="8"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                BorderBrush="#66FFFFFF"
                BorderThickness="1"
                CornerRadius="28">
                <Border.Background>
                    <AcrylicBrush TintColor="#9BA2A8" TintOpacity="0.42" TintLuminosityOpacity="0.72" FallbackColor="#D9959CA4" />
                </Border.Background>
                <Grid RowSpacing="8" ColumnSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="102" />
                        <RowDefinition Height="54" />
                        <RowDefinition Height="102" />
                        <RowDefinition Height="54" />
                        <RowDefinition Height="54" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="102" />
                        <ColumnDefinition Width="102" />
                        <ColumnDefinition Width="86" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.ColumnSpan="2" Padding="8" Background="#5A313840" CornerRadius="22">
                        <Grid RowSpacing="6" ColumnSpacing="6">
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Button Width="43" Height="43" Padding="0" Background="#FF7F8A96" BorderBrush="#00FFFFFF" CornerRadius="22" Command="{x:Bind ViewModel.OpenAirplaneModeCommand}" AutomationProperties.Name="Airplane mode">
                                <FontIcon Glyph="&#xE709;" FontSize="19" Foreground="White" />
                            </Button>
                            <Button Grid.Column="1" Width="43" Height="43" Padding="0" Background="#FF0A84FF" BorderBrush="#00FFFFFF" CornerRadius="22" Command="{x:Bind ViewModel.OpenWifiCommand}" AutomationProperties.Name="Wi-Fi">
                                <FontIcon Glyph="&#xE701;" FontSize="19" Foreground="White" />
                            </Button>
                            <Button Grid.Row="1" Width="43" Height="43" Padding="0" Background="#FF0A84FF" BorderBrush="#00FFFFFF" CornerRadius="22" Command="{x:Bind ViewModel.OpenBluetoothCommand}" AutomationProperties.Name="Bluetooth">
                                <FontIcon Glyph="&#xE702;" FontSize="19" Foreground="White" />
                            </Button>
                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE8BD;" FontSize="14" Foreground="#FF30D158" />
                                <FontIcon Glyph="&#xE702;" FontSize="14" Foreground="#FF0A84FF" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Padding="10,8" Background="#5A313840" CornerRadius="22">
                        <Grid RowSpacing="5">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="34" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="24" />
                            </Grid.RowDefinitions>
                            <Button Width="34" Height="34" Padding="0" HorizontalAlignment="Right" Background="#FF3E6FA7" BorderBrush="#00FFFFFF" CornerRadius="17" Command="{x:Bind ViewModel.OpenDisplayCommand}" AutomationProperties.Name="Display output">
                                <FontIcon Glyph="&#xE7F4;" FontSize="14" Foreground="White" />
                            </Button>
                            <TextBlock Grid.Row="1" Text="Not Playing" VerticalAlignment="Center" Foreground="#DFFFFFFF" FontSize="11" FontWeight="SemiBold" />
                            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="7">
                                <FontIcon Glyph="&#xE100;" FontSize="12" Foreground="White" />
                                <FontIcon Glyph="&#xE768;" FontSize="16" Foreground="White" />
                                <FontIcon Glyph="&#xE101;" FontSize="12" Foreground="White" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Button Grid.Row="1" Width="54" Height="54" Padding="0" Background="#6A313840" BorderBrush="#00FFFFFF" CornerRadius="27" Command="{x:Bind ViewModel.LockScreenCommand}" AutomationProperties.Name="Lock screen">
                        <FontIcon Glyph="&#xE72E;" FontSize="21" Foreground="White" />
                    </Button>
                    <Button Grid.Row="1" Grid.Column="1" Width="54" Height="54" Padding="0" Background="#6A313840" BorderBrush="#00FFFFFF" CornerRadius="27" Command="{x:Bind ViewModel.OpenDisplayCommand}" AutomationProperties.Name="Screen mirroring">
                        <FontIcon Glyph="&#xE7F4;" FontSize="22" Foreground="White" />
                    </Button>
                    <Border Grid.Row="1" Grid.Column="2" Background="#6A313840" CornerRadius="22">
                        <TextBlock Text="{x:Bind ViewModel.BatteryPercentLabel, Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" FontSize="13" FontWeight="SemiBold" />
                    </Border>

                    <Border Grid.Row="2" Grid.ColumnSpan="2" Background="#6A313840" CornerRadius="22">
                        <Button Padding="13,0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" BorderBrush="#00FFFFFF" Command="{x:Bind ViewModel.OpenFocusCommand}" AutomationProperties.Name="Focus">
                            <StackPanel Orientation="Horizontal" Spacing="9">
                                <Border Width="36" Height="36" Background="#FF4B5869" CornerRadius="18">
                                    <FontIcon Glyph="&#xE708;" FontSize="18" Foreground="White" />
                                </Border>
                                <TextBlock Text="Focus" VerticalAlignment="Center" Foreground="White" FontSize="13" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                    </Border>

                    <Grid Grid.Row="2" Grid.Column="2" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Border Background="#74FFFFFF" CornerRadius="18">
                            <Grid>
                                <Border Height="{x:Bind ViewModel.BrightnessPercent, Mode=OneWay}" VerticalAlignment="Bottom" Background="#E8FFFFFF" CornerRadius="0,0,18,18" />
                                <Slider x:Name="BrightnessSlider" Minimum="0" Maximum="100" Value="{x:Bind ViewModel.BrightnessPercent, Mode=OneWay}" Orientation="Vertical" Opacity="0.01" ValueChanged="OnBrightnessSliderValueChanged" AutomationProperties.Name="Brightness" />
                                <FontIcon Glyph="&#xE706;" VerticalAlignment="Bottom" Margin="0,0,0,13" FontSize="18" Foreground="#FFCFB000" />
                            </Grid>
                        </Border>
                        <Border Grid.Column="1" Background="#74FFFFFF" CornerRadius="18">
                            <Grid>
                                <Border Height="{x:Bind ViewModel.VolumePercent, Mode=OneWay}" VerticalAlignment="Bottom" Background="#E8FFFFFF" CornerRadius="0,0,18,18" />
                                <Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" Value="{x:Bind ViewModel.VolumePercent, Mode=OneWay}" Orientation="Vertical" Opacity="0.01" ValueChanged="OnVolumeSliderValueChanged" AutomationProperties.Name="Volume" />
                                <FontIcon Glyph="&#xE767;" VerticalAlignment="Bottom" Margin="0,0,0,13" FontSize="18" Foreground="#FF0A84FF" />
                            </Grid>
                        </Border>
                    </Grid>

                    <Button Grid.Row="3" Width="54" Height="54" Padding="0" Background="#FF29335F" BorderBrush="#00FFFFFF" CornerRadius="27" Command="{x:Bind ViewModel.ToggleMuteCommand}" AutomationProperties.Name="Mute">
                        <FontIcon Glyph="&#xE767;" FontSize="20" Foreground="White" />
                    </Button>
                    <Button Grid.Row="3" Grid.Column="1" Width="54" Height="54" Padding="0" Background="#6A313840" BorderBrush="#00FFFFFF" CornerRadius="27" Command="{x:Bind ViewModel.OpenScreenClipCommand}" AutomationProperties.Name="Screenshot">
                        <FontIcon Glyph="&#xE722;" FontSize="20" Foreground="White" />
                    </Button>
                    <Button Grid.Row="3" Grid.Column="2" Width="54" Height="54" Padding="0" Background="#F7FFFFFF" BorderBrush="#00FFFFFF" CornerRadius="27" Command="{x:Bind ViewModel.OpenCameraCommand}" AutomationProperties.Name="Camera">
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="Selfie" Command="{x:Bind ViewModel.OpenCameraSelfieCommand}" Icon="Contact" />
                                <MenuFlyoutItem Text="Video" Command="{x:Bind ViewModel.OpenCameraVideoCommand}" Icon="Video" />
                                <MenuFlyoutItem Text="Photo" Command="{x:Bind ViewModel.OpenCameraPhotoCommand}" Icon="Camera" />
                            </MenuFlyout>
                        </Button.Flyout>
                        <FontIcon Glyph="&#xE722;" FontSize="20" Foreground="#FF30343B" />
                    </Button>

                    <Border Grid.Row="4" Grid.ColumnSpan="3" Padding="12,0" Background="#5A313840" CornerRadius="20">
                        <Grid>
                            <TextBlock Text="{x:Bind ViewModel.ModeLabel, Mode=OneWay}" VerticalAlignment="Center" Foreground="#EFFFFFFF" FontSize="12" FontWeight="SemiBold" />
                            <TextBlock Text="{x:Bind ViewModel.CurrentTime, Mode=OneWay}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#DFFFFFFF" FontSize="12" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Grid
            Visibility="{Binding IsTaskSwitcherOpen, Converter={StaticResource BoolToVisibilityConverter}}"
            AutomationProperties.Name="CoreDesk Task Switcher">
            <Grid.Background>
                <AcrylicBrush
                    TintColor="#0B1520"
                    TintOpacity="0.48"
                    TintLuminosityOpacity="0.18"
                    FallbackColor="#D90B1520" />
            </Grid.Background>
            <Grid>
                <Grid.Background>
                    <RadialGradientBrush Center="0.5,0.18" RadiusX="0.74" RadiusY="0.86">
                        <GradientStop Color="#26FFFFFF" Offset="0" />
                        <GradientStop Color="#111D3448" Offset="0.48" />
                        <GradientStop Color="#99071018" Offset="1" />
                    </RadialGradientBrush>
                </Grid.Background>
            </Grid>
            <Grid Padding="88,58,88,160" RowSpacing="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="App Switcher" FontSize="34" FontWeight="SemiBold" Foreground="White" />
                        <TextBlock Text="Running apps" FontSize="16" Foreground="#D9FFFFFF" />
                    </StackPanel>
                    <Button Grid.Column="1" Command="{x:Bind ViewModel.CloseTaskSwitcherCommand}" Width="56" Height="56" Padding="0" Background="#2EFFFFFF" BorderBrush="#42FFFFFF" CornerRadius="28" AutomationProperties.Name="Close Task Switcher">
                        <FontIcon Glyph="&#xE711;" FontSize="18" />
                    </Button>
                </Grid>
                <ScrollViewer Grid.Row="1" HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Hidden" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{x:Bind ViewModel.TaskSwitcherItems, Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Vertical" MaximumRowsOrColumns="2" ItemWidth="430" ItemHeight="330" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="viewModels:DockItemViewModel">
                                <Button Width="410" Height="312" Margin="10,8" Padding="0" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" Click="OnDockAppClick" Tag="{x:Bind}">
                                    <Grid>
                                        <Border
                                            Margin="0,12,0,0"
                                            Background="#33000000"
                                            CornerRadius="34" />
                                        <Border Background="#EAF4F8FB" BorderBrush="#8DFFFFFF" BorderThickness="1" CornerRadius="34">
                                            <Grid RowSpacing="0">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="58" />
                                                </Grid.RowDefinitions>
                                                <Border Margin="10,10,10,0" Background="#FF17222E" CornerRadius="26">
                                                    <Grid>
                                                        <Image
                                                            Source="{x:Bind PreviewPath, Converter={StaticResource IconPathToImageSourceConverter}, Mode=OneWay}"
                                                            Stretch="UniformToFill"
                                                            Visibility="{x:Bind PreviewPath, Converter={StaticResource IconPathToVisibilityConverter}, Mode=OneWay}" />
                                                        <Border
                                                            Background="{x:Bind IconPath, Converter={StaticResource IconPathToBrushConverter}, Mode=OneWay}"
                                                            Visibility="{x:Bind PreviewPath, Converter={StaticResource IconPathToVisibilityConverter}, ConverterParameter=Invert, Mode=OneWay}">
                                                            <Grid>
                                                                <Border Margin="34" Background="#24FFFFFF" CornerRadius="24" />
                                                                <FontIcon Glyph="&#xECAA;" FontSize="58" Foreground="#EFFFFFFF" Visibility="{x:Bind IconPath, Converter={StaticResource IconPathToVisibilityConverter}, ConverterParameter=Invert, Mode=OneWay}" />
                                                                <Image Source="{x:Bind IconPath, Converter={StaticResource IconPathToImageSourceConverter}, Mode=OneWay}" Margin="74" Stretch="Uniform" Visibility="{x:Bind IconPath, Converter={StaticResource IconPathToVisibilityConverter}, Mode=OneWay}" />
                                                            </Grid>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                                <Grid Grid.Row="1" Margin="18,0,18,0" ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="38" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="34" Height="34" Background="{x:Bind IconPath, Converter={StaticResource IconPathToBrushConverter}, Mode=OneWay}" CornerRadius="9">
                                                        <Grid>
                                                            <FontIcon Glyph="&#xECAA;" FontSize="16" Foreground="#EFFFFFFF" Visibility="{x:Bind IconPath, Converter={StaticResource IconPathToVisibilityConverter}, ConverterParameter=Invert, Mode=OneWay}" />
                                                            <Image Source="{x:Bind IconPath, Converter={StaticResource IconPathToImageSourceConverter}, Mode=OneWay}" Margin="5" Stretch="Uniform" Visibility="{x:Bind IconPath, Converter={StaticResource IconPathToVisibilityConverter}, Mode=OneWay}" />
                                                        </Grid>
                                                    </Border>
                                                    <TextBlock Grid.Column="1" Text="{x:Bind DisplayName}" FontSize="16" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Foreground="#FF111820" VerticalAlignment="Center" />
                                                    <Border Grid.Column="2" Width="9" Height="9" VerticalAlignment="Center" Background="#FF0A84FF" CornerRadius="4.5" />
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>

        <Grid
            RequestedTheme="Light"
            AutomationProperties.Name="CoreDesk Settings"
            Visibility="{Binding IsSettingsOpen, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FFF3F7FB" Offset="0" />
                    <GradientStop Color="#FFE8F3FA" Offset="0.45" />
                    <GradientStop Color="#FFF8EEF4" Offset="1" />
                </LinearGradientBrush>
            </Grid.Background>
            <Border
                Width="520"
                HorizontalAlignment="Right"
                Background="#220073C8" />
            <Border
                Width="9"
                HorizontalAlignment="Left"
                Background="#FF0078D4" />
            <Grid Padding="{Binding ShellPadding, Converter={StaticResource DoubleToUniformThicknessConverter}}" RowSpacing="26">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock Text="{x:Bind ViewModel.SettingsLabel}" FontSize="38" FontWeight="SemiBold" Foreground="#FF111820" />
                        <TextBlock Text="TouchShell behavior, appearance, apps, gestures and diagnostics" FontSize="16" Foreground="#AA111820" />
                    </StackPanel>
                    <Button Grid.Column="1" Command="{x:Bind ViewModel.CloseSettingsCommand}" Width="64" Height="64" AutomationProperties.Name="Close Settings">
                        <FontIcon Glyph="&#xE711;" />
                    </Button>
                </Grid>
                <Grid Grid.Row="1" ColumnSpacing="26">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320" />
                        <ColumnDefinition Width="760" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ListView SelectedIndex="0" Background="Transparent">
                        <ListViewItem Content="General" />
                        <ListViewItem Content="Appearance" />
                        <ListViewItem Content="Behavior" />
                        <ListViewItem Content="Apps" />
                        <ListViewItem Content="Updates" />
                        <ListViewItem Content="Gestures" />
                        <ListViewItem Content="System" />
                    </ListView>
                    <ScrollViewer Grid.Column="1">
                        <StackPanel Spacing="18" MaxWidth="860" HorizontalAlignment="Left">
                            <ToggleSwitch Header="Autostart" IsOn="{Binding Settings.AutostartEnabled, Mode=TwoWay}" />
                            <ToggleSwitch Header="Hide taskbar in touch mode" IsOn="{Binding Settings.HideTaskbarInTouchMode, Mode=TwoWay}" />
                            <ToggleSwitch Header="Auto switch when keyboard changes" IsOn="{Binding Settings.AutoSwitchOnKeyboard, Mode=TwoWay}" />
                            <ToggleSwitch Header="Reduce animations" IsOn="{Binding Settings.ReduceAnimations, Mode=TwoWay}" />
                            <ComboBox Header="Language" ItemsSource="{Binding Settings.Languages}" SelectedItem="{Binding Settings.Language, Mode=TwoWay}" MinWidth="220" />
                            <ComboBox Header="Theme" ItemsSource="{Binding Settings.Themes}" SelectedItem="{Binding Settings.Theme, Mode=TwoWay}" MinWidth="220" />
                            <ComboBox Header="Dock position" ItemsSource="{Binding Settings.DockPositions}" SelectedItem="{Binding Settings.DockPosition, Mode=TwoWay}" MinWidth="220" />
                            <Border Padding="22" Background="#EFFFFFFF" BorderBrush="#66FFFFFF" BorderThickness="1" CornerRadius="24">
                                <StackPanel Spacing="14">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="Updates" FontSize="22" FontWeight="SemiBold" Foreground="#FF111820" />
                                            <TextBlock Text="{Binding Settings.UpdateStatus}" Foreground="#AA111820" FontSize="14" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <FontIcon Grid.Column="1" Glyph="&#xE895;" FontSize="28" Foreground="#FF0078D4" />
                                    </Grid>
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Installed" Foreground="#99111820" FontSize="12" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Settings.InstalledVersion}" Foreground="#FF111820" FontSize="18" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Latest" Foreground="#99111820" FontSize="12" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Settings.LatestVersion}" Foreground="#FF111820" FontSize="18" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Grid>
                                    <ProgressBar
                                        Minimum="0"
                                        Maximum="100"
                                        Value="{Binding Settings.UpdateProgress, Mode=OneWay}"
                                        IsIndeterminate="{Binding Settings.IsCheckingForUpdates, Mode=OneWay}" />
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Button Command="{Binding Settings.CheckForUpdatesCommand}" MinHeight="48" Padding="16,0" AutomationProperties.Name="Check for Updates">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xE895;" />
                                                <TextBlock Text="Check" />
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding Settings.InstallUpdateCommand}" IsEnabled="{Binding Settings.CanInstallUpdate, Mode=OneWay}" MinHeight="48" Padding="16,0" AutomationProperties.Name="Install Update">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xE896;" />
                                                <TextBlock Text="Install update" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Button Command="{Binding Settings.SaveCommand}" AutomationProperties.Name="Save Settings" MinHeight="54" Padding="18,0">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE74E;" />
                                    <TextBlock Text="Save" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>
                    <StackPanel Grid.Column="2" Width="480" HorizontalAlignment="Right" Spacing="18">
                        <Border Padding="24" Background="#EFFFFFFF" BorderBrush="#66FFFFFF" BorderThickness="1" CornerRadius="28">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Shell status" FontSize="15" FontWeight="SemiBold" Foreground="#99111820" />
                                <TextBlock Text="{x:Bind ViewModel.ModeLabel, Mode=OneWay}" FontSize="34" FontWeight="SemiBold" Foreground="#FF111820" />
                                <TextBlock Text="{x:Bind ViewModel.AppCountLabel, Mode=OneWay}" FontSize="17" Foreground="#AA111820" />
                            </StackPanel>
                        </Border>
                        <Border Padding="24" Background="#EFFFFFFF" BorderBrush="#66FFFFFF" BorderThickness="1" CornerRadius="28">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Display" FontSize="15" FontWeight="SemiBold" Foreground="#99111820" />
                                <TextBlock Text="{x:Bind ViewModel.DisplaySummary, Mode=OneWay}" FontSize="28" FontWeight="SemiBold" Foreground="#FF111820" />
                                <TextBlock Text="{x:Bind ViewModel.DpiSummary, Mode=OneWay}" FontSize="17" Foreground="#AA111820" />
                            </StackPanel>
                        </Border>
                        <Border Padding="24" Background="#EFFFFFFF" BorderBrush="#66FFFFFF" BorderThickness="1" CornerRadius="28">
                            <StackPanel Spacing="8">
                                <TextBlock Text="System" FontSize="15" FontWeight="SemiBold" Foreground="#99111820" />
                                <TextBlock Text="{x:Bind ViewModel.BatteryLabel, Mode=OneWay}" FontSize="22" FontWeight="SemiBold" Foreground="#FF111820" />
                                <TextBlock Text="{x:Bind ViewModel.NetworkLabel, Mode=OneWay}" FontSize="17" Foreground="#AA111820" />
                                <TextBlock Text="{x:Bind ViewModel.KeyboardLabel, Mode=OneWay}" FontSize="17" Foreground="#AA111820" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

        <local:AppIconContextMenu
            x:Name="HomeAppContextMenu"
            ActionRequested="OnHomeAppContextMenuActionRequested" />

        <Grid
            x:Name="StartupErrorOverlay"
            Visibility="Collapsed"
            Background="#CC081018">
            <Border
                Width="680"
                MaxWidth="720"
                Padding="28"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#F5FFFFFF"
                BorderBrush="#80FFFFFF"
                BorderThickness="1"
                CornerRadius="22">
                <StackPanel Spacing="12">
                    <TextBlock Text="CoreDesk konnte den Homescreen nicht fertig laden" Foreground="#FF101820" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="StartupErrorMessage" Foreground="#CC101820" FontSize="15" TextWrapping="WrapWholeWords" />
                    <TextBlock Text="Details wurden in den CoreDesk-Diagnostics-Log geschrieben." Foreground="#99101820" FontSize="13" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
