<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="CoreDesk_App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:CoreDesk.Abstractions.Models"
    xmlns:viewModels="using:CoreDesk.Application.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:CoreDesk_App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid
        x:Name="Root"
        AutomationProperties.Name="CoreDesk Homescreen"
        Background="Transparent"
        SizeChanged="OnRootSizeChanged">
        <Grid Visibility="{Binding IsTouchMode, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#20394F" Offset="0" />
                    <GradientStop Color="#67869C" Offset="0.48" />
                    <GradientStop Color="#C08B6A" Offset="1" />
                </LinearGradientBrush>
            </Grid.Background>
        </Grid>

        <Image
            x:Name="WallpaperImage"
            Stretch="UniformToFill"
            Opacity="0.94"
            Visibility="{Binding IsTouchMode, Converter={StaticResource BoolToVisibilityConverter}}" />

        <Grid Visibility="{Binding IsTouchMode, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.Background>
                <RadialGradientBrush Center="0.58,0.35" RadiusX="0.92" RadiusY="0.92">
                    <GradientStop Color="#44FFFFFF" Offset="0" />
                    <GradientStop Color="#26344B61" Offset="0.62" />
                    <GradientStop Color="#66101A24" Offset="1" />
                </RadialGradientBrush>
            </Grid.Background>
        </Grid>

        <Border Background="#26000000" Visibility="{Binding IsTouchMode, Converter={StaticResource BoolToVisibilityConverter}}" />

        <Grid Padding="{Binding ShellPadding, Converter={StaticResource DoubleToUniformThicknessConverter}}" Visibility="{Binding IsTouchMode, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Text="{x:Bind ViewModel.AppTitle}"
                    FontSize="32"
                    FontWeight="SemiBold"
                    Foreground="White" />

                <Border
                    Grid.Column="1"
                    Padding="16,8"
                    Background="#4D111820"
                    BorderBrush="#22FFFFFF"
                    BorderThickness="1"
                    CornerRadius="20">
                    <StackPanel Orientation="Horizontal" Spacing="14">
                        <TextBlock Text="{x:Bind ViewModel.CurrentTime, Mode=OneWay}" Foreground="White" FontWeight="SemiBold" />
                        <TextBlock Text="{x:Bind ViewModel.BatteryLabel, Mode=OneWay}" Foreground="White" />
                        <TextBlock Text="{x:Bind ViewModel.NetworkLabel, Mode=OneWay}" Foreground="White" />
                        <TextBlock Text="{x:Bind ViewModel.KeyboardLabel, Mode=OneWay}" Foreground="White" />
                        <TextBlock Text="{x:Bind ViewModel.ModeLabel, Mode=OneWay}" Foreground="White" />
                    </StackPanel>
                </Border>
            </Grid>

            <ItemsControl
                Grid.Row="1"
                Margin="0,28,0,8"
                ItemsSource="{x:Bind ViewModel.Widgets, Mode=OneWay}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="18" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:HomeWidgetViewModel">
                        <Border
                            Width="380"
                            Height="132"
                            Padding="24,20"
                            Background="#D9FFFFFF"
                            BorderBrush="#44FFFFFF"
                            BorderThickness="1"
                            CornerRadius="30">
                            <StackPanel Spacing="5">
                                <TextBlock Text="{x:Bind Title}" Foreground="#B0212B34" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Bind PrimaryText}" Foreground="#FF111820" FontSize="30" FontWeight="SemiBold" MaxLines="1" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind SecondaryText}" Foreground="#CC111820" FontSize="15" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <GridView
                x:Name="HomeGrid"
                Grid.Row="2"
                Margin="0,22,0,24"
                IsItemClickEnabled="True"
                ItemClick="OnAppItemClick"
                ItemsSource="{x:Bind ViewModel.HomeTiles, Mode=OneWay}"
                SelectionMode="None">
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="8" />
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:HomeTileViewModel">
                        <StackPanel
                            Width="150"
                            Height="174"
                            Padding="8"
                            Spacing="10">
                            <Border
                                Width="108"
                                Height="108"
                                HorizontalAlignment="Center"
                                Background="{Binding IconPath, Converter={StaticResource IconPathToBrushConverter}}"
                                CornerRadius="24"
                                Visibility="{Binding IsAppTile, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Grid>
                                    <FontIcon
                                        Glyph="&#xECAA;"
                                        FontSize="42"
                                        Foreground="#EFFFFFFF"
                                        Visibility="{Binding IconPath, Converter={StaticResource IconPathToVisibilityConverter}, ConverterParameter=Invert}" />
                                    <Image
                                        Source="{Binding IconPath, Converter={StaticResource IconPathToImageSourceConverter}}"
                                        Margin="19"
                                        Stretch="Uniform"
                                        Visibility="{Binding IconPath, Converter={StaticResource IconPathToVisibilityConverter}}" />
                                </Grid>
                            </Border>
                            <Border
                                Width="108"
                                Height="108"
                                HorizontalAlignment="Center"
                                Background="#DCF7F8FA"
                                CornerRadius="24"
                                Visibility="{Binding IsFolderTile, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Grid Padding="12">
                                    <ItemsControl ItemsSource="{x:Bind FolderPreviewApps, Mode=OneWay}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="2" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:AppEntry">
                                                <Border Width="38" Height="38" Margin="3" Background="{Binding IconPath, Converter={StaticResource IconPathToBrushConverter}}" CornerRadius="9">
                                                    <Grid>
                                                        <FontIcon Glyph="&#xECAA;" FontSize="17" Foreground="#EFFFFFFF" Visibility="{Binding IconPath, Converter={StaticResource IconPathToVisibilityConverter}, ConverterParameter=Invert}" />
                                                        <Image Source="{Binding IconPath, Converter={StaticResource IconPathToImageSourceConverter}}" Margin="5" Stretch="Uniform" Visibility="{Binding IconPath, Converter={StaticResource IconPathToVisibilityConverter}}" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Border Width="24" Height="24" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="#F2FFFFFF" CornerRadius="12" Visibility="{Binding HasFolderApps, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="{x:Bind AppCount}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="#FF111820" />
                                    </Border>
                                </Grid>
                            </Border>
                            <TextBlock
                                Text="{x:Bind DisplayName, Mode=OneWay}"
                                TextAlignment="Center"
                                TextWrapping="Wrap"
                                MaxLines="2"
                                Foreground="White"
                                FontWeight="SemiBold"
                                FontSize="14" />
                        </StackPanel>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>

            <StackPanel Grid.Row="3" HorizontalAlignment="Center" Orientation="Horizontal" Spacing="9" Margin="0,0,0,13">
                <Border Width="30" Height="8" Background="#FFFFFFFF" CornerRadius="4" />
                <Border Width="8" Height="8" Background="#99FFFFFF" CornerRadius="4" />
                <Border Width="8" Height="8" Background="#99FFFFFF" CornerRadius="4" />
            </StackPanel>

            <Border
                x:Name="DockSurface"
                Grid.Row="4"
                HorizontalAlignment="Center"
                Padding="20,16"
                BorderBrush="#66FFFFFF"
                BorderThickness="1"
                CornerRadius="38"
                Visibility="{Binding IsDockVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                AutomationProperties.Name="CoreDesk Dock">
                <Border.Background>
                    <AcrylicBrush
                        TintColor="#DCEAF0"
                        TintOpacity="0.2"
                        TintLuminosityOpacity="0.28"
                        FallbackColor="#55212C34" />
                </Border.Background>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <ItemsControl ItemsSource="{x:Bind ViewModel.PinnedDockItems, Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="10" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="viewModels:DockItemViewModel">
                                <Button
                                    Width="{Binding DataContext.DockButtonSize, ElementName=Root, Mode=OneWay}"
                                    Height="{Binding DataContext.DockButtonSize, ElementName=Root, Mode=OneWay}"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    BorderThickness="0"
                                    Click="OnDockAppClick"
                                    Tag="{x:Bind}">
                                    <Grid RowSpacing="4">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="3" />
                                        </Grid.RowDefinitions>
                                        <Grid Width="54" Height="54">
                                            <FontIcon Glyph="&#xECAA;" FontSize="28" Foreground="#F026323C" Visibility="{x:Bind IconPath, Converter={StaticResource IconPathToVisibilityConverter}, ConverterParameter=Invert, Mode=OneWay}" />
                                            <Image Source="{x:Bind IconPath, Converter={StaticResource IconPathToImageSourceConverter}, Mode=OneWay}" Stretch="Uniform" Visibility="{x:Bind IconPath, Converter={StaticResource IconPathToVisibilityConverter}, Mode=OneWay}" />
                                        </Grid>
                                        <Border
                                            Grid.Row="1"
                                            Width="18"
                                            Height="3"
                                            HorizontalAlignment="Center"
                                            Background="#FF0A84FF"
                                            CornerRadius="1.5"
                                            Visibility="{x:Bind IsRunning, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Width="1" Height="46" Margin="4,5" Background="#73FFFFFF" CornerRadius="0.5" />

                    <ItemsControl ItemsSource="{x:Bind ViewModel.RunningDockItems, Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="10" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="viewModels:DockItemViewModel">
                                <Button
                                    Width="{Binding DataContext.DockButtonSize, ElementName=Root, Mode=OneWay}"
                                    Height="{Binding DataContext.DockButtonSize, ElementName=Root, Mode=OneWay}"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    BorderThickness="0"
                                    Click="OnDockAppClick"
                                    Tag="{x:Bind}">
                                    <Grid RowSpacing="4">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="3" />
                                        </Grid.RowDefinitions>
                                        <Grid Width="54" Height="54">
                                            <FontIcon Glyph="&#xECAA;" FontSize="28" Foreground="#F026323C" Visibility="{x:Bind IconPath, Converter={StaticResource IconPathToVisibilityConverter}, ConverterParameter=Invert, Mode=OneWay}" />
                                            <Image Source="{x:Bind IconPath, Converter={StaticResource IconPathToImageSourceConverter}, Mode=OneWay}" Stretch="Uniform" Visibility="{x:Bind IconPath, Converter={StaticResource IconPathToVisibilityConverter}, Mode=OneWay}" />
                                        </Grid>
                                        <Border
                                            Grid.Row="1"
                                            Width="18"
                                            Height="3"
                                            HorizontalAlignment="Center"
                                            Background="#FF0A84FF"
                                            CornerRadius="1.5" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Width="{x:Bind ViewModel.DockButtonSize, Mode=OneWay}" Height="{x:Bind ViewModel.DockButtonSize, Mode=OneWay}" Padding="0" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" Command="{x:Bind ViewModel.OpenDrawerCommand}" AutomationProperties.Name="Open App Drawer">
                        <FontIcon Glyph="&#xE71D;" FontSize="{x:Bind ViewModel.DockIconSize, Mode=OneWay}" />
                    </Button>
                    <Button Width="{x:Bind ViewModel.DockButtonSize, Mode=OneWay}" Height="{x:Bind ViewModel.DockButtonSize, Mode=OneWay}" Padding="0" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" Command="{x:Bind ViewModel.OpenSettingsCommand}" AutomationProperties.Name="Open Settings">
                        <FontIcon Glyph="&#xE713;" FontSize="{x:Bind ViewModel.DockIconSize, Mode=OneWay}" />
                    </Button>
                    <Button Width="{x:Bind ViewModel.DockButtonSize, Mode=OneWay}" Height="{x:Bind ViewModel.DockButtonSize, Mode=OneWay}" Padding="0" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" Command="{x:Bind ViewModel.OpenControlCenterCommand}" AutomationProperties.Name="Open Control Center">
                        <FontIcon Glyph="&#xE700;" FontSize="{x:Bind ViewModel.DockIconSize, Mode=OneWay}" />
                    </Button>
                    <Button Width="{x:Bind ViewModel.DockButtonSize, Mode=OneWay}" Height="{x:Bind ViewModel.DockButtonSize, Mode=OneWay}" Padding="0" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" Command="{x:Bind ViewModel.ToggleDesktopCommand}" AutomationProperties.Name="Toggle Desktop Mode">
                        <FontIcon Glyph="&#xE7F4;" FontSize="{x:Bind ViewModel.DockIconSize, Mode=OneWay}" />
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <Grid
            AutomationProperties.Name="CoreDesk App Drawer"
            Visibility="{Binding IsDrawerOpen, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.Background>
                <AcrylicBrush TintColor="#111820" TintOpacity="0.78" TintLuminosityOpacity="0.68" FallbackColor="#F2111820" />
            </Grid.Background>
            <Grid Padding="{Binding ShellPadding, Converter={StaticResource DoubleToUniformThicknessConverter}}" RowSpacing="22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid ColumnSpacing="18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Height="64" Padding="18,0" Background="#F2FFFFFF" BorderBrush="#44FFFFFF" BorderThickness="1" CornerRadius="22">
                        <TextBox
                            PlaceholderText="{x:Bind ViewModel.SearchPlaceholder}"
                            Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            FontSize="20"
                            BorderThickness="0"
                            Background="Transparent"
                            Foreground="#FF101820"
                            PlaceholderForeground="#99101820"
                            MinHeight="54"
                            VerticalAlignment="Center"
                            VerticalContentAlignment="Center" />
                    </Border>
                    <Button Grid.Column="1" Command="{x:Bind ViewModel.CloseDrawerCommand}" Width="64" Height="64" Padding="0" AutomationProperties.Name="Close App Drawer">
                        <FontIcon Glyph="&#xE711;" />
                    </Button>
                </Grid>

                <GridView
                    Grid.Row="1"
                    IsItemClickEnabled="True"
                    ItemClick="OnAppItemClick"
                    ItemsSource="{x:Bind ViewModel.DrawerApps, Mode=OneWay}"
                    SelectionMode="None">
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="models:AppEntry">
                            <StackPanel
                                Width="154"
                                Height="158"
                                Padding="8"
                                Spacing="8">
                                <Border
                                    Width="96"
                                    Height="96"
                                    HorizontalAlignment="Center"
                                    Background="{Binding IconPath, Converter={StaticResource IconPathToBrushConverter}}"
                                    CornerRadius="22">
                                    <Grid>
                                        <FontIcon Glyph="&#xECAA;" FontSize="40" Foreground="#EFFFFFFF" Visibility="{Binding IconPath, Converter={StaticResource IconPathToVisibilityConverter}, ConverterParameter=Invert}" />
                                        <Image Source="{Binding IconPath, Converter={StaticResource IconPathToImageSourceConverter}}" Margin="17" Stretch="Uniform" Visibility="{Binding IconPath, Converter={StaticResource IconPathToVisibilityConverter}}" />
                                    </Grid>
                                </Border>
                                <TextBlock Text="{x:Bind DisplayName}" TextAlignment="Center" TextWrapping="Wrap" MaxLines="2" Foreground="White" FontWeight="SemiBold" FontSize="13" />
                            </StackPanel>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </Grid>
        </Grid>

        <Grid
            AutomationProperties.Name="CoreDesk Folder"
            Visibility="{Binding IsFolderOpen, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.Background>
                <AcrylicBrush TintColor="#101820" TintOpacity="0.55" TintLuminosityOpacity="0.55" FallbackColor="#AA101820" />
            </Grid.Background>
            <Border
                Width="680"
                MinHeight="460"
                Padding="32"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#F2FFFFFF"
                BorderBrush="#66FFFFFF"
                BorderThickness="1"
                CornerRadius="38">
                <StackPanel Spacing="22">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding OpenFolderTile.Name}" FontSize="30" FontWeight="SemiBold" Foreground="#FF111820" />
                        <Button Grid.Column="1" Command="{x:Bind ViewModel.CloseFolderCommand}" AutomationProperties.Name="Close Folder">
                            <FontIcon Glyph="&#xE711;" />
                        </Button>
                    </Grid>
                    <GridView
                        MaxHeight="420"
                        IsItemClickEnabled="True"
                        ItemClick="OnAppItemClick"
                        ItemsSource="{x:Bind ViewModel.OpenFolderApps, Mode=OneWay}"
                        SelectionMode="None">
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="models:AppEntry">
                                <StackPanel Width="136" Height="146" Padding="8" Spacing="8">
                                    <Border
                                        Width="86"
                                        Height="86"
                                        HorizontalAlignment="Center"
                                        Background="{Binding IconPath, Converter={StaticResource IconPathToBrushConverter}}"
                                        CornerRadius="20">
                                        <Grid>
                                            <FontIcon Glyph="&#xECAA;" FontSize="34" Foreground="#EFFFFFFF" Visibility="{Binding IconPath, Converter={StaticResource IconPathToVisibilityConverter}, ConverterParameter=Invert}" />
                                            <Image Source="{Binding IconPath, Converter={StaticResource IconPathToImageSourceConverter}}" Margin="16" Stretch="Uniform" Visibility="{Binding IconPath, Converter={StaticResource IconPathToVisibilityConverter}}" />
                                        </Grid>
                                    </Border>
                                    <TextBlock Text="{x:Bind DisplayName}" TextAlignment="Center" TextWrapping="Wrap" MaxLines="2" Foreground="#FF111820" FontSize="13" FontWeight="SemiBold" />
                                </StackPanel>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                </StackPanel>
            </Border>
        </Grid>

        <Grid
            AutomationProperties.Name="CoreDesk Control Center"
            Visibility="{Binding IsControlCenterOpen, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border HorizontalAlignment="Stretch" Background="#3D071018" />
            <Border
                Width="560"
                MaxWidth="620"
                Margin="0,34,34,0"
                Padding="24"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                BorderBrush="#80FFFFFF"
                BorderThickness="1"
                CornerRadius="30">
                <Border.Background>
                    <AcrylicBrush TintColor="#17222E" TintOpacity="0.66" TintLuminosityOpacity="0.72" FallbackColor="#F017222E" />
                </Border.Background>
                <Grid RowSpacing="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="{x:Bind ViewModel.ControlCenterLabel}" FontSize="30" FontWeight="SemiBold" Foreground="White" />
                            <TextBlock Text="{x:Bind ViewModel.ModeLabel, Mode=OneWay}" FontSize="14" Foreground="#CCFFFFFF" />
                        </StackPanel>
                        <Button Grid.Column="1" Command="{x:Bind ViewModel.CloseControlCenterCommand}" Width="50" Height="50" Padding="0" Background="#22FFFFFF" BorderBrush="#24FFFFFF" AutomationProperties.Name="Close Control Center">
                            <FontIcon Glyph="&#xE711;" FontSize="18" />
                        </Button>
                    </Grid>

                    <Grid Grid.Row="1" ColumnSpacing="12" RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="104" />
                            <RowDefinition Height="104" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Button Command="{x:Bind ViewModel.ToggleDesktopCommand}" Padding="18" Background="#22FFFFFF" BorderBrush="#26FFFFFF" AutomationProperties.Name="Desktop quick action">
                            <StackPanel Spacing="9" HorizontalAlignment="Left">
                                <FontIcon Glyph="&#xE7F4;" FontSize="28" />
                                <TextBlock Text="{x:Bind ViewModel.DesktopLabel}" FontSize="16" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="1" Padding="18" Background="#22FFFFFF" BorderBrush="#26FFFFFF" AutomationProperties.Name="Wi-Fi quick action">
                            <StackPanel Spacing="9" HorizontalAlignment="Left">
                                <FontIcon Glyph="&#xE701;" FontSize="28" />
                                <TextBlock Text="{x:Bind ViewModel.NetworkLabel, Mode=OneWay}" FontSize="16" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Row="1" Padding="18" Background="#22FFFFFF" BorderBrush="#26FFFFFF" AutomationProperties.Name="Bluetooth quick action">
                            <StackPanel Spacing="9" HorizontalAlignment="Left">
                                <FontIcon Glyph="&#xE702;" FontSize="28" />
                                <TextBlock Text="Bluetooth" FontSize="16" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Row="1" Grid.Column="1" Padding="18" Background="#22FFFFFF" BorderBrush="#26FFFFFF" AutomationProperties.Name="Touch keyboard quick action">
                            <StackPanel Spacing="9" HorizontalAlignment="Left">
                                <FontIcon Glyph="&#xE765;" FontSize="28" />
                                <TextBlock Text="{x:Bind ViewModel.KeyboardLabel, Mode=OneWay}" FontSize="16" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Border Grid.Row="2" Padding="20,18" Background="#2EFFFFFF" BorderBrush="#32FFFFFF" BorderThickness="1" CornerRadius="24">
                        <StackPanel Spacing="16">
                            <Grid>
                                <TextBlock Text="Brightness" Foreground="White" FontSize="16" FontWeight="SemiBold" />
                                <FontIcon Glyph="&#xE706;" HorizontalAlignment="Right" FontSize="22" Foreground="#CCFFFFFF" />
                            </Grid>
                            <Slider Minimum="0" Maximum="100" Value="72" AutomationProperties.Name="Brightness" />
                            <Grid>
                                <TextBlock Text="Volume" Foreground="White" FontSize="16" FontWeight="SemiBold" />
                                <FontIcon Glyph="&#xE767;" HorizontalAlignment="Right" FontSize="22" Foreground="#CCFFFFFF" />
                            </Grid>
                            <Slider Minimum="0" Maximum="100" Value="48" AutomationProperties.Name="Volume" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="3" Padding="20,16" Background="#1FFFFFFF" BorderBrush="#2AFFFFFF" BorderThickness="1" CornerRadius="24">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="5">
                                <TextBlock Text="{x:Bind ViewModel.BatteryLabel, Mode=OneWay}" Foreground="White" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Bind ViewModel.CurrentTime, Mode=OneWay}" Foreground="#CCFFFFFF" FontSize="14" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.KeyboardLabel, Mode=OneWay}" VerticalAlignment="Center" Foreground="#E6FFFFFF" FontWeight="SemiBold" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Grid
            Background="#66071018"
            Visibility="{Binding IsTaskSwitcherOpen, Converter={StaticResource BoolToVisibilityConverter}}"
            AutomationProperties.Name="CoreDesk Task Switcher">
            <Grid Padding="96,96,96,190" RowSpacing="26">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="App Switcher" FontSize="34" FontWeight="SemiBold" Foreground="White" />
                        <TextBlock Text="Running apps" FontSize="16" Foreground="#CCFFFFFF" />
                    </StackPanel>
                    <Button Grid.Column="1" Command="{x:Bind ViewModel.CloseTaskSwitcherCommand}" Width="56" Height="56" Padding="0" AutomationProperties.Name="Close Task Switcher">
                        <FontIcon Glyph="&#xE711;" FontSize="18" />
                    </Button>
                </Grid>
                <ItemsControl Grid.Row="1" ItemsSource="{x:Bind ViewModel.RunningDockItems, Mode=OneWay}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="22" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="viewModels:DockItemViewModel">
                            <Button Width="250" Height="330" Padding="0" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" Click="OnDockAppClick" Tag="{x:Bind}">
                                <Border Padding="18" Background="#DDF7FAFC" BorderBrush="#66FFFFFF" BorderThickness="1" CornerRadius="28">
                                    <Grid RowSpacing="18">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Border Background="{x:Bind IconPath, Converter={StaticResource IconPathToBrushConverter}, Mode=OneWay}" CornerRadius="22">
                                            <Grid>
                                                <FontIcon Glyph="&#xECAA;" FontSize="46" Foreground="#EFFFFFFF" Visibility="{x:Bind IconPath, Converter={StaticResource IconPathToVisibilityConverter}, ConverterParameter=Invert, Mode=OneWay}" />
                                                <Image Source="{x:Bind IconPath, Converter={StaticResource IconPathToImageSourceConverter}, Mode=OneWay}" Margin="56" Stretch="Uniform" Visibility="{x:Bind IconPath, Converter={StaticResource IconPathToVisibilityConverter}, Mode=OneWay}" />
                                            </Grid>
                                        </Border>
                                        <TextBlock Grid.Row="1" Text="{x:Bind DisplayName}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" Foreground="#FF111820" />
                                    </Grid>
                                </Border>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Grid>

        <Grid
            RequestedTheme="Light"
            AutomationProperties.Name="CoreDesk Settings"
            Visibility="{Binding IsSettingsOpen, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FFF3F7FB" Offset="0" />
                    <GradientStop Color="#FFE8F3FA" Offset="0.45" />
                    <GradientStop Color="#FFF8EEF4" Offset="1" />
                </LinearGradientBrush>
            </Grid.Background>
            <Border
                Width="520"
                HorizontalAlignment="Right"
                Background="#220073C8" />
            <Border
                Width="9"
                HorizontalAlignment="Left"
                Background="#FF0078D4" />
            <Grid Padding="{Binding ShellPadding, Converter={StaticResource DoubleToUniformThicknessConverter}}" RowSpacing="26">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock Text="{x:Bind ViewModel.SettingsLabel}" FontSize="38" FontWeight="SemiBold" Foreground="#FF111820" />
                        <TextBlock Text="TouchShell behavior, appearance, apps, gestures and diagnostics" FontSize="16" Foreground="#AA111820" />
                    </StackPanel>
                    <Button Grid.Column="1" Command="{x:Bind ViewModel.CloseSettingsCommand}" Width="64" Height="64" AutomationProperties.Name="Close Settings">
                        <FontIcon Glyph="&#xE711;" />
                    </Button>
                </Grid>
                <Grid Grid.Row="1" ColumnSpacing="26">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320" />
                        <ColumnDefinition Width="760" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ListView SelectedIndex="0" Background="Transparent">
                        <ListViewItem Content="General" />
                        <ListViewItem Content="Appearance" />
                        <ListViewItem Content="Behavior" />
                        <ListViewItem Content="Apps" />
                        <ListViewItem Content="Updates" />
                        <ListViewItem Content="Gestures" />
                        <ListViewItem Content="System" />
                    </ListView>
                    <ScrollViewer Grid.Column="1">
                        <StackPanel Spacing="18" MaxWidth="860" HorizontalAlignment="Left">
                            <ToggleSwitch Header="Autostart" IsOn="{Binding Settings.AutostartEnabled, Mode=TwoWay}" />
                            <ToggleSwitch Header="Hide taskbar in touch mode" IsOn="{Binding Settings.HideTaskbarInTouchMode, Mode=TwoWay}" />
                            <ToggleSwitch Header="Auto switch when keyboard changes" IsOn="{Binding Settings.AutoSwitchOnKeyboard, Mode=TwoWay}" />
                            <ToggleSwitch Header="Reduce animations" IsOn="{Binding Settings.ReduceAnimations, Mode=TwoWay}" />
                            <ComboBox Header="Language" ItemsSource="{Binding Settings.Languages}" SelectedItem="{Binding Settings.Language, Mode=TwoWay}" MinWidth="220" />
                            <ComboBox Header="Theme" ItemsSource="{Binding Settings.Themes}" SelectedItem="{Binding Settings.Theme, Mode=TwoWay}" MinWidth="220" />
                            <ComboBox Header="Dock position" ItemsSource="{Binding Settings.DockPositions}" SelectedItem="{Binding Settings.DockPosition, Mode=TwoWay}" MinWidth="220" />
                            <Border Padding="22" Background="#EFFFFFFF" BorderBrush="#66FFFFFF" BorderThickness="1" CornerRadius="24">
                                <StackPanel Spacing="14">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="Updates" FontSize="22" FontWeight="SemiBold" Foreground="#FF111820" />
                                            <TextBlock Text="{Binding Settings.UpdateStatus}" Foreground="#AA111820" FontSize="14" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <FontIcon Grid.Column="1" Glyph="&#xE895;" FontSize="28" Foreground="#FF0078D4" />
                                    </Grid>
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Installed" Foreground="#99111820" FontSize="12" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Settings.InstalledVersion}" Foreground="#FF111820" FontSize="18" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Latest" Foreground="#99111820" FontSize="12" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Settings.LatestVersion}" Foreground="#FF111820" FontSize="18" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Grid>
                                    <ProgressBar
                                        Minimum="0"
                                        Maximum="100"
                                        Value="{Binding Settings.UpdateProgress, Mode=OneWay}"
                                        IsIndeterminate="{Binding Settings.IsCheckingForUpdates, Mode=OneWay}" />
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Button Command="{Binding Settings.CheckForUpdatesCommand}" MinHeight="48" Padding="16,0" AutomationProperties.Name="Check for Updates">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xE895;" />
                                                <TextBlock Text="Check" />
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding Settings.InstallUpdateCommand}" IsEnabled="{Binding Settings.CanInstallUpdate, Mode=OneWay}" MinHeight="48" Padding="16,0" AutomationProperties.Name="Install Update">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xE896;" />
                                                <TextBlock Text="Install update" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Button Command="{Binding Settings.SaveCommand}" AutomationProperties.Name="Save Settings" MinHeight="54" Padding="18,0">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE74E;" />
                                    <TextBlock Text="Save" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>
                    <StackPanel Grid.Column="2" Width="480" HorizontalAlignment="Right" Spacing="18">
                        <Border Padding="24" Background="#EFFFFFFF" BorderBrush="#66FFFFFF" BorderThickness="1" CornerRadius="28">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Shell status" FontSize="15" FontWeight="SemiBold" Foreground="#99111820" />
                                <TextBlock Text="{x:Bind ViewModel.ModeLabel, Mode=OneWay}" FontSize="34" FontWeight="SemiBold" Foreground="#FF111820" />
                                <TextBlock Text="{x:Bind ViewModel.AppCountLabel, Mode=OneWay}" FontSize="17" Foreground="#AA111820" />
                            </StackPanel>
                        </Border>
                        <Border Padding="24" Background="#EFFFFFFF" BorderBrush="#66FFFFFF" BorderThickness="1" CornerRadius="28">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Display" FontSize="15" FontWeight="SemiBold" Foreground="#99111820" />
                                <TextBlock Text="{x:Bind ViewModel.DisplaySummary, Mode=OneWay}" FontSize="28" FontWeight="SemiBold" Foreground="#FF111820" />
                                <TextBlock Text="{x:Bind ViewModel.DpiSummary, Mode=OneWay}" FontSize="17" Foreground="#AA111820" />
                            </StackPanel>
                        </Border>
                        <Border Padding="24" Background="#EFFFFFFF" BorderBrush="#66FFFFFF" BorderThickness="1" CornerRadius="28">
                            <StackPanel Spacing="8">
                                <TextBlock Text="System" FontSize="15" FontWeight="SemiBold" Foreground="#99111820" />
                                <TextBlock Text="{x:Bind ViewModel.BatteryLabel, Mode=OneWay}" FontSize="22" FontWeight="SemiBold" Foreground="#FF111820" />
                                <TextBlock Text="{x:Bind ViewModel.NetworkLabel, Mode=OneWay}" FontSize="17" Foreground="#AA111820" />
                                <TextBlock Text="{x:Bind ViewModel.KeyboardLabel, Mode=OneWay}" FontSize="17" Foreground="#AA111820" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Page>
